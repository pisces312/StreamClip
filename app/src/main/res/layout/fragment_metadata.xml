<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_800"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_metadata"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Video Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etVideoPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:textColor="@color/white"
                android:textColorHint="@color/gray_500"
                android:hint="@string/metadata_select_video_hint"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="textNoSuggestions"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="true" />

            <Button
                android:id="@+id/btnSelectVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_video"
                android:layout_marginStart="8dp"
                android:minWidth="80dp" />

        </LinearLayout>

        <!-- Metadata Fields -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/metadata_fields"
            android:textColor="@color/gray_400"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/metadata_title"
            android:textColor="@color/gray_400"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_500"
            android:hint="@string/metadata_title_hint"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <!-- Artist -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/metadata_artist"
            android:textColor="@color/gray_400"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_500"
            android:hint="@string/metadata_artist_hint"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <!-- Creation Time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/metadata_creation_time"
            android:textColor="@color/gray_400"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etCreationTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_500"
            android:hint="@string/metadata_creation_time_hint"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <!-- Location (GPS) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/metadata_location"
            android:textColor="@color/gray_400"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_500"
            android:hint="@string/metadata_location_hint"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <!-- Comment -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/metadata_comment"
            android:textColor="@color/gray_400"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etComment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/white"
            android:textColorHint="@color/gray_500"
            android:hint="@string/metadata_comment_hint"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="4"
            android:layout_marginBottom="16dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reset"
                android:layout_marginEnd="8dp"
                android:enabled="false" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/metadata_save"
                android:enabled="false" />

        </LinearLayout>

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
