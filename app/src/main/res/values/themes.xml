<resources>
    <style name="Theme.StreamClip" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
    </style>

    <style name="TabTextTwoLine" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">12sp</item>
        <item name="android:singleLine">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:lineSpacingMultiplier">0.9</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.StreamClip.SettingButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/gray_600</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/gray_700</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
